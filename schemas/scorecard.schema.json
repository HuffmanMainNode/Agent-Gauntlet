{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huffmanmainnode.github.io/Agent-Gauntlet/schemas/scorecard.schema.json",
  "title": "Agent Gauntlet Public Scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "created_at",
    "agent",
    "operator",
    "benchmark",
    "balanced_behavior_index",
    "index_explanation",
    "evidence",
    "environment",
    "attestation",
    "limitations",
    "scorecard_sha256",
    "provenance",
    "gri"
  ],
  "properties": {
    "format": {
      "const": "agent-gauntlet-scorecard-v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "model_id",
        "adapter_version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operator": {
      "type": "string"
    },
    "benchmark": {
      "type": "object",
      "required": [
        "suite_count",
        "case_count",
        "suites"
      ],
      "properties": {
        "suite_count": {
          "type": "integer",
          "minimum": 1
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "suites": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "cases",
              "behavior_pass_rate",
              "mean_case_score",
              "unsupported_claims",
              "execution_failures",
              "malformed_claims",
              "abstention_rate",
              "conflict_reports"
            ],
            "properties": {
              "cases": {
                "type": "integer",
                "minimum": 1
              },
              "behavior_pass_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "mean_case_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "unsupported_claims": {
                "type": "integer",
                "minimum": 0
              },
              "execution_failures": {
                "type": "integer",
                "minimum": 0
              },
              "malformed_claims": {
                "type": "integer",
                "minimum": 0
              },
              "abstention_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "conflict_reports": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "balanced_behavior_index": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "index_explanation": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "suite",
          "run_id",
          "evidence_sha256",
          "results_sha256",
          "verified_artifacts"
        ],
        "properties": {
          "suite": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "results_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verified_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "environment": {
      "type": "object"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scheme",
        "identity",
        "namespace",
        "signature_file",
        "signed_object"
      ],
      "properties": {
        "status": {
          "enum": [
            "unsigned",
            "signed"
          ]
        },
        "scheme": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "signed_object": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scorecard_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_commit",
        "challenge_pack_hashes",
        "bundle_root_sha256",
        "bundle_file_count",
        "challenge_pack_count",
        "root_algorithm",
        "pack_result_count",
        "scorecard_claims_sha256"
      ],
      "properties": {
        "repo_commit": {
          "type": "string",
          "minLength": 1
        },
        "challenge_pack_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "bundle_root_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "challenge_pack_count": {
          "type": "integer",
          "minimum": 0
        },
        "root_algorithm": {
          "const": "sha256(sorted-path-hash-pairs-v1)"
        },
        "pack_result_count": {
          "type": "integer",
          "minimum": 0
        },
        "scorecard_claims_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "gri": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "expected_domains",
        "evaluated_domains",
        "missing_domains",
        "penalized_domains",
        "penalty_reasons",
        "domain_scores",
        "coverage_ratio",
        "composite_score",
        "observed_geometric_mean",
        "complete",
        "result_count",
        "normalization"
      ],
      "properties": {
        "format": {
          "const": "gauntlet-reliability-index-v1"
        },
        "expected_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evaluated_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "missing_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "penalized_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "penalty_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "PERMISSION_VIOLATION",
                "INJECTION_BREACH"
              ]
            }
          }
        },
        "domain_scores": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "composite_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "observed_geometric_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "complete": {
          "type": "boolean"
        },
        "result_count": {
          "type": "integer",
          "minimum": 0
        },
        "normalization": {
          "type": "string"
        }
      }
    }
  }
}
