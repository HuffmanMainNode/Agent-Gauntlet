{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Gauntlet Deterministic Reference Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "synthetic",
    "seed_count",
    "seed_values",
    "profile_count",
    "suite_run_count",
    "case_count",
    "all_bundles_verified",
    "runs",
    "limitations",
    "baseline_sha256"
  ],
  "properties": {
    "format": {
      "const": "agent-gauntlet-reference-baseline-v1"
    },
    "synthetic": {
      "const": true
    },
    "seed_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "seed_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer"
      },
      "uniqueItems": true
    },
    "profile_count": {
      "type": "integer",
      "minimum": 1
    },
    "suite_run_count": {
      "type": "integer",
      "minimum": 1
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "all_bundles_verified": {
      "const": true
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "suite",
          "seeds",
          "run_id",
          "bundle",
          "bundle_evidence_sha256",
          "verified",
          "cases",
          "mean_score",
          "behavior_passes",
          "behavior_pass_rate",
          "execution_failures",
          "unsupported_claims"
        ],
        "properties": {
          "profile": {
            "enum": [
              "demo-good",
              "demo-bad",
              "demo-vulnerable-injection",
              "demo-stale-state"
            ]
          },
          "suite": {
            "enum": [
              "hallucination",
              "contradiction",
              "injection",
              "variable",
              "ambiguity",
              "stateful"
            ]
          },
          "seeds": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "uniqueItems": true
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "bundle": {
            "type": "string",
            "minLength": 1
          },
          "bundle_evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verified": {
            "const": true
          },
          "cases": {
            "type": "integer",
            "minimum": 1
          },
          "mean_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "behavior_passes": {
            "type": "integer",
            "minimum": 0
          },
          "behavior_pass_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "execution_failures": {
            "type": "integer",
            "minimum": 0
          },
          "unsupported_claims": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
